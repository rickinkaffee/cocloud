[Unit]
Description=Incremental personal memory extraction
After=cocloud-memory-gateway.service
[Service]
EnvironmentFile=/etc/open-workbench/memory.env
Type=simple
WorkingDirectory=/opt/open-workbench/extensions/memory
ExecStart=/opt/open-workbench-memory/venv/bin/python /opt/open-workbench/extensions/memory/profile_memory.py
Restart=on-failure
RestartSec=10
Nice=15
CPUQuota=30%
MemoryMax=256M
[Install]
WantedBy=multi-user.target
