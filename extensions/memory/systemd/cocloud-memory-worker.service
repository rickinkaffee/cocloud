[Unit]
Description=Incremental memory consolidation queue
After=network.target
[Service]
EnvironmentFile=/etc/open-workbench/memory.env
Type=simple
User=workbench
WorkingDirectory=/opt/open-workbench/extensions/memory
ExecStart=/opt/open-workbench-memory/venv/bin/python /opt/open-workbench/extensions/memory/worker.py
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=30%
MemoryMax=256M
MemorySwapMax=128M
OOMScoreAdjust=500
[Install]
WantedBy=multi-user.target
