WORKBENCH_ORIGIN=https://workbench.example
WORKBENCH_INTERNAL_URL=http://127.0.0.1:3773
PROXY_URL=http://127.0.0.1:17890
PROXY_SERVICE=workbench-outbound-proxy.service
PROXY_CONTROL_PORT=3794
# Match the workbench server and shell user's GitHub CLI credential directory.
GH_CONFIG_DIR=/var/lib/open-workbench/.config/gh
PROXY_STATE_DIR=/var/lib/open-workbench-proxy
GITHUB_RUN_SOCKET=/run/open-workbench-proxy/github.sock
