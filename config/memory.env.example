# Copy outside the checkout; restrict permissions to the service account.
MEMORY_DATA=/var/lib/open-workbench-memory
MEMORY_MODEL_ID=
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_API_KEY=
MEMORY_PYTHON=/opt/open-workbench-memory/venv/bin/python
WORKBENCH_ORIGIN=https://workbench.example
WORKBENCH_INTERNAL_URL=http://127.0.0.1:3773
# Optional explicit source paths; omitted sources default to empty import folders.
# MEMORY_WORKBENCH_DB=/path/to/your/statev2.sqlite
# MEMORY_CODEX_SESSIONS=/path/to/your/sessions
